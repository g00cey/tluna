{
  "$schema": "https://opencode.ai/config.json",

  "providers": {
    "lemonade": {
      "package": "@opencode/ai/providers/openai-compatible",
      "name": "Lemonade Server",
      "settings": {
        "baseURL": "http://172.16.1.20:13305/api/v1",
        "timeout": false,
        // ローカル推論は長いプロンプトの prefill に時間がかかるため既定の 5 分から 30 分に延長
        "headerTimeout": 1800000,
        "chunkTimeout": 1800000
      },
      "models": {
        // build: コーディング特化 / 262k ctx
        "Qwen3.8-Flash-Next-GGUF-UD-IQ3_XXS": {
          "name": "Qwen3.8-Flash-Next-GGUF-UD-IQ3_XXS",
          "modelID": "Qwen3.8-Flash-Next-GGUF-UD-IQ3_XXS",
          "capabilities": { "tools": true, "input": ["text"], "output": ["text"] },
          "limit": { "context": 262144, "output": 32768 }
        },
        // plan / escalation: 推論系・最大モデル (106B MoE)
        "GLM-5.3-Flash": {
          "name": "GLM-5.3-Flash",
          "modelID": "GLM-5.3-Flash-GGUF-UD-IQ2_XXS",
          "capabilities": {
            "tools": true,
            "input": ["text"],
            "output": ["text"],
            "reasoning": { "supported": true }
          },
          "limit": { "context": 131072, "output": 32768 }
        },
        // general / explore / scout: 高速 MoE
        "Gemma-4-26B-A4B-it": {
          "name": "Gemma 4 26B A4B",
          "modelID": "Gemma-4-26B-A4B-it-GGUF",
          "capabilities": { "tools": true, "input": ["text"], "output": ["text"] },
          "limit": { "context": 262144, "output": 32768 }
        },
        // general / explore / scout: 高速 MoE
        "gemma4-it-e4b-FLM": {
          "name": "gemma4-it-e4b-FLM",
          "modelID": "gemma4-it-e4b-FLM",
          "capabilities": { "tools": true, "input": ["text"], "output": ["text"] },
          "limit": { "context": 262144, "output": 32768 }
        },
        // reviewer: build と別系統の推論モデル
        "gpt-oss-120b": {
          "name": "gpt-oss 120B",
          "modelID": "gpt-oss-120b-GGUF-MXFP4",
          "capabilities": {
            "tools": true,
            "input": ["text"],
            "output": ["text"],
            "reasoning": { "supported": true }
          },
          "limit": { "context": 131072, "output": 16384 }
        },
        // small_model: タイトル生成等の軽量用途
        "Gemma-4-E4B-it": {
          "name": "Gemma 4 E4B",
          "modelID": "Gemma-4-E4B-it-GGUF",
          "capabilities": { "tools": true, "input": ["text"], "output": ["text"] },
          "limit": { "context": 131072, "output": 16384 }
        }
      }
    }
  },

  "mcp": {
    "awslabs.aws-pricing-mcp-server": {
      "type": "local",
      "command": ["uvx", "awslabs.aws-pricing-mcp-server@latest"],
      "environment": {
        "FASTMCP_LOG_LEVEL": "ERROR",
        "AWS_PROFILE": "default",
        "AWS_REGION": "us-east-1"
      },
      "enabled": true
    }
  },

  "plugin": ["opencode-ignore"],

  // ツール出力の truncation 上限 (既定: 2000 行 / 50KB)
  "tool_output": {
    "max_lines": 4000,
    "max_bytes": 204800
  },

  "permission": {
    "read": {
      "*": "allow",
      "*.env": "deny",
      "**/secrets/**": "deny"
    }
  },

  "model": "lemonade/Qwen3.8-Flash-Next-GGUF-UD-IQ3_XXS",
  "small_model": "lemonade/gemma4-it-e4b-FLM",

  "agent": {
    "build": {
      "mode": "primary",
      "model": "lemonade/Qwen3.8-Flash-Next-GGUF-UD-IQ3_XXS",
      "tools": {
        "write": true,
        "edit": true,
        "bash": true
      },
      "permission": {
        "task": {
          "*": "deny",
          "general": "allow",
          "explore": "allow",
          "scout": "allow",
          "reviewer": "allow",
          "escalation": "ask"
        }
      }
    },
    "plan": {
      "mode": "primary",
      "model": "lemonade/GLM-5.3-Flash",
      "temperature": 0.1,
      "tools": {
        "write": false,
        "edit": false,
        "bash": false
      },
      "permission": {
        "task": {
          "*": "deny",
          "explore": "allow",
          "scout": "allow"
        }
      }
    },
    "general": {
      "mode": "subagent",
      "model": "lemonade/gemma4-it-e4b-FLM",
      "description": "複数ファイルにまたがる調査・並列作業単位の実行"
    },
    "explore": {
      "mode": "subagent",
      "model": "lemonade/gemma4-it-e4b-FLM",
      "description": "コードベース内の高速読み取り専用検索",
      "tools": {
        "write": false,
        "edit": false,
        "bash": false
      }
    },
    "scout": {
      "mode": "subagent",
      "model": "lemonade/gemma4-it-e4b-FLM",
      "description": "外部依存関係・upstreamリポジトリの調査",
      "tools": {
        "write": false,
        "edit": false
      }
    },
    "reviewer": {
      "mode": "subagent",
      "hidden": true,
      "model": "lemonade/GLM-5.3-Flash",
      "description": "実装差分のレビュー。セキュリティ・保守性・パフォーマンスの観点で指摘のみ行う",
      "temperature": 0.1,
      "tools": {
        "write": false,
        "edit": false,
        "bash": false
      }
    },
    "escalation": {
      "mode": "subagent",
      "hidden": true,
      "model": "lemonade/GLM-5.3-Flash",
      "description": "buildやreviewerが行き詰まった難問のみに使う高コスト・低頻度の切り札",
      "tools": {
        "write": false,
        "edit": false,
        "bash": true
      }
    }
  }
}
