{
  "$schema": "https://opencode.ai/config.json",

  "provider": {
    "lemonade": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Lemonade Server",
      "options": {
        "baseURL": "http://172.16.1.20:13305/api/v1",
        "timeout": false,
        // ローカル推論は長いプロンプトの prefill に時間がかかるため既定の 5 分から 30 分に延長
        "headerTimeout": 1800000,
        "chunkTimeout": 1800000
      },
      "models": {
        // build: コーディング特化 / 262k ctx
        "Qwen3-Coder-Next-GGUF": {
          "name": "Qwen3 Coder Next",
          "tool_call": true,
          "limit": { "context": 262144, "output": 32768 }
        },
        // plan / escalation: 推論系・最大モデル (106B MoE)
        "GLM-4.5-Air-UD-Q4K-XL-GGUF": {
          "name": "GLM-4.5 Air",
          "tool_call": true,
          "reasoning": true,
          "limit": { "context": 131072, "output": 32768 }
        },
        // general / explore / scout: 高速 MoE
        "Gemma-4-26B-A4B-it-GGUF": {
          "name": "Gemma 4 26B A4B",
          "tool_call": true,
          "limit": { "context": 262144, "output": 32768 }
        },
        // reviewer: build と別系統の推論モデル
        "gpt-oss-120b-GGUF-MXFP4": {
          "name": "gpt-oss 120B",
          "tool_call": true,
          "reasoning": true,
          "limit": { "context": 131072, "output": 16384 }
        },
        // small_model: タイトル生成等の軽量用途
        "Gemma-4-E4B-it-GGUF": {
          "name": "Gemma 4 E4B",
          "tool_call": true,
          "limit": { "context": 131072, "output": 16384 }
        }
      }
    }
  },

  "mcp": {
    "awslabs.aws-pricing-mcp-server": {
      "type": "local",
      "command": ["uvx", "awslabs.aws-pricing-mcp-server@latest"],
      "environment": {
        "FASTMCP_LOG_LEVEL": "ERROR",
        "AWS_PROFILE": "default",
        "AWS_REGION": "us-east-1"
      },
      "enabled": true
    }
  },

  "plugin": ["opencode-ignore"],

  "permission": {
    "read": {
      "*": "allow",
      "*.env": "deny",
      "**/secrets/**": "deny"
    }
  },

  "model": "lemonade/Qwen3-Coder-Next-GGUF",
  "small_model": "lemonade/Gemma-4-E4B-it-GGUF",

  "agent": {
    "build": {
      "mode": "primary",
      "model": "lemonade/Qwen3-Coder-Next-GGUF",
      "tools": {
        "write": true,
        "edit": true,
        "bash": true
      },
      "permission": {
        "task": {
          "*": "deny",
          "general": "allow",
          "explore": "allow",
          "scout": "allow",
          "reviewer": "allow",
          "escalation": "ask"
        }
      }
    },
    "plan": {
      "mode": "primary",
      "model": "lemonade/Qwen3-Coder-Next-GGUF",
      "temperature": 0.1,
      "tools": {
        "write": false,
        "edit": false,
        "bash": false
      },
      "permission": {
        "task": {
          "*": "deny",
          "explore": "allow",
          "scout": "allow"
        }
      }
    },
    "general": {
      "mode": "subagent",
      "model": "lemonade/Gemma-4-26B-A4B-it-GGUF",
      "description": "複数ファイルにまたがる調査・並列作業単位の実行"
    },
    "explore": {
      "mode": "subagent",
      "model": "lemonade/Gemma-4-26B-A4B-it-GGUF",
      "description": "コードベース内の高速読み取り専用検索",
      "tools": {
        "write": false,
        "edit": false,
        "bash": false
      }
    },
    "scout": {
      "mode": "subagent",
      "model": "lemonade/Gemma-4-26B-A4B-it-GGUF",
      "description": "外部依存関係・upstreamリポジトリの調査",
      "tools": {
        "write": false,
        "edit": false
      }
    },
    "reviewer": {
      "mode": "subagent",
      "hidden": true,
      "model": "lemonade/GLM-4.5-Air-UD-Q4K-XL-GGUF",
      "description": "実装差分のレビュー。セキュリティ・保守性・パフォーマンスの観点で指摘のみ行う",
      "temperature": 0.1,
      "tools": {
        "write": false,
        "edit": false,
        "bash": false
      }
    },
    "escalation": {
      "mode": "subagent",
      "hidden": true,
      "model": "lemonade/GLM-4.5-Air-UD-Q4K-XL-GGUF",
      "description": "buildやreviewerが行き詰まった難問のみに使う高コスト・低頻度の切り札",
      "tools": {
        "write": false,
        "edit": false,
        "bash": true
      }
    }
  }
}
